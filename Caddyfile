# Musawo Training Center — Caddyfile
# Replace learn.musawotraining.ug with your actual domain.

learn.musawotraining.ug {
  # Automatic HTTPS via Let's Encrypt
  tls {
    protocols tls1.2 tls1.3
  }

  # Security headers
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  # Reverse proxy to Next.js app
  reverse_proxy app:3000 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Real-IP {remote_host}
  }

  # Compression
  encode gzip zstd

  # Cache static assets aggressively (1 year, immutable)
  @static {
    path /_next/static/*
    path /assets/*
    path /favicon.ico
    path /manifest.json
    path /icons/*
    path /icon.png
    path /apple-icon.png
  }
  header @static Cache-Control "public, max-age=31536000, immutable"

  # Cache Next.js optimized images for 7 days (Next.js controls the URL
  # fingerprint via query params, so stale responses are never served)
  @nextimage {
    path /_next/image*
  }
  header @nextimage Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

  # Logs
  log {
    output file /data/access.log {
      roll_size 10mb
      roll_keep 5
    }
  }
}
