// Musawo Training Center - Prisma Schema
// Version 1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  // ── Active roles ──────────────────────────────────────────────
  SUPER_ADMIN          // Managing Director / CEO / CFO. Max 3 accounts.
  BOARD_MEMBER         // Read-only reports and aggregates.
  PRINCIPAL            // Academic head; approves content, results, graduands.
  DEPUTY_PRINCIPAL     // Daily operations; delegates from Principal.
  ACADEMIC_REGISTRAR   // Student records, enrolments, academic calendar.
  INSTRUCTOR           // Teaching staff (was TUTOR).
  TEACHING_ASSISTANT   // Supporting staff; limited upload and roll-call.
  FINANCE_OFFICER      // Payments, ledger, holds (was BURSAR).
  HR_SYSTEM_ADMIN      // Staff accounts, leave, non-secret settings.
  AUDITOR_READONLY     // Legal advisor; view-only, every view logged.
  SYSTEM_IT            // Technical settings, integrations, backups.
  STUDENT              // Learner account.
  // ── Legacy aliases kept until data is migrated ────────────────
  SUPERADMIN           // -> SUPER_ADMIN
  ADMINISTRATOR        // -> HR_SYSTEM_ADMIN
  BURSAR               // -> FINANCE_OFFICER
  TUTOR                // -> INSTRUCTOR
  REGISTRAR            // -> ACADEMIC_REGISTRAR
  ADMIN                // -> ACADEMIC_REGISTRAR
  SPONSOR              // -> remove after seed migration
  EMPLOYER             // -> remove after seed migration
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION   // email not yet confirmed
  PENDING_ACCEPTANCE     // Registrar created account; student not yet confirmed details
  DETAILS_DISPUTED       // student flagged details as wrong
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  NOTES
  QUIZ
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum EnrolmentStatus {
  PENDING_PAYMENT    // registered, payment not started or failed
  ACTIVE             // fully paid (or first instalment for instalment plan)
  PARTIALLY_PAID     // instalment plan: some blocks unlocked, more due
  OVERDUE            // instalment missed, in grace period
  COMPLETED          // all lessons done, exams passed, cert issued
  SUSPENDED          // admin-suspended
  REFUNDED           // refund approved, access ended
  CANCELLED          // student or admin cancelled before any payment
}

enum PaymentStatus {
  PENDING
  PENDING_APPROVAL   // bank transfer uploaded, waiting admin approval
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentGateway {
  PESAPAL
  FLUTTERWAVE
  MANUAL
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  CARD
  BANK_TRANSFER
  MANUAL
}

enum LedgerEntryType {
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AttendanceMark {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  MARKED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  PAYMENT_REFUNDED
  CERTIFICATE_ISSUED
  CERTIFICATE_REVOKED
  ENROLMENT_CREATED
  ENROLMENT_SUSPENDED
  EXAM_STARTED
  EXAM_SUBMITTED
  SETTINGS_CHANGED
  ROLE_CHANGED
  ACCOUNT_SUSPENDED
  BULK_EXPORT
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  BREAK_GLASS_GRANTED
  BREAK_GLASS_EXPIRED
  TOTP_ENABLED
  TOTP_DISABLED
  ACCESS_REVIEW_COMPLETED
  PAYMENT_CLAIM_SUBMITTED
  PAYMENT_CLAIM_VERIFIED
  PAYMENT_CLAIM_REJECTED
  PAYMENT_REVERSED
  STATEMENT_IMPORTED
  RECONCILIATION_ALERT
  ROLES_PERMISSIONS_VIEWED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ManualPaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY_MTN
  MOBILE_MONEY_AIRTEL
  CASH
}

enum ApprovalRequestType {
  REFUND
  WAIVER
  FEE_CHANGE
  STAFF_ACCOUNT_CREATE
  STAFF_ACCOUNT_SUSPEND
  STAFF_ACCOUNT_ROLE_CHANGE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ─────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────

model User {
  id                String      @id @default(cuid())
  studentNumber     String?     @unique  // MTC-2026-00042
  name              String
  email             String?     @unique
  phone             String?     @unique
  professionalTitle String?
  registrationNumber String?
  dateOfBirth       DateTime?
  gender            String?
  district          String?
  highestQualification String?
  idNumberEncrypted String?
  emergencyContact  String?
  emailVerified     DateTime?
  phoneVerified     DateTime?
  passwordHash      String?
  role              UserRole    @default(STUDENT)
  status            UserStatus  @default(PENDING_VERIFICATION)
  avatarUrl         String?
  dataConsentAt     DateTime?
  // Institution Secretary flag: a BOARD_MEMBER with this flag also gets
  // policies.manage and board_documents.manage (checked via canForUser).
  institutionSecretary Boolean  @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // TOTP / 2FA - required for SUPERADMIN, optional for staff
  totpSecret        String?     // encrypted at app layer
  totpEnabled       Boolean     @default(false)
  totpVerifiedAt    DateTime?   // last successful TOTP verification in session

  // Access review
  lastAccessReviewAt DateTime?

  // Auth.js
  accounts          Account[]
  sessions          Session[]

  // Learning
  enrolments        Enrolment[]
  lessonProgress    LessonProgress[]
  examAttempts      ExamAttempt[]
  attendance        Attendance[]
  presence          PlatformPresence?
  certificates      Certificate[]
  notifications     Notification[]
  notificationPrefs NotificationPref[]
  dashboardWidgetPreferences DashboardWidgetPreference[]

  // Staff
  taughtCourses     Course[]          @relation("CourseMainTutor")
  coTaughtCourses   CoTutor[]
  liveClasses       LiveClass[]
  shortAnswerReviews ShortAnswerReview[]

  // Assignments
  assignmentSubmissions AssignmentSubmission[]
  gradedSubmissions     AssignmentSubmission[] @relation("GraderSubmissions")

  // Announcements & forum
  announcements     Announcement[]
  forumThreads      ForumThread[]
  forumReplies      ForumReply[]

  // Support
  supportTickets    SupportTicket[]
  assignedTickets   SupportTicket[] @relation("AssignedTickets")
  supportReplies    SupportReply[]

  // Grades
  gradeEntries      GradeEntry[]

  // Admin
  auditLogs         AuditLog[]        @relation("ActorAuditLog")
  settingsUpdated   SiteSetting[]
  resources         Resource[]

  // OTPs
  otpCodes          OtpCode[]

  // Approvals
  approvalRequestsInitiated ApprovalRequest[] @relation("ApprovalInitiator")
  approvalRequestsDecided   ApprovalRequest[] @relation("ApprovalDecider")

  // Break-glass
  breakGlassGrants  BreakGlassGrant[]

  // Staff invites created by this user
  staffInvitesSent      StaffInvite[]
  // Student invites sent to this user (resendable, so many)
  studentInvites        StaffInvite[]  @relation("StudentInviteUser")

  // Manual payment claims
  fraudStrikes      Int                    @default(0)
  claimsSubmitted   ManualPaymentClaim[]   @relation("ClaimantClaims")
  claimsReviewed    ManualPaymentClaim[]   @relation("ClaimReviewer")
  claimsVerified    ManualPaymentClaim[]   @relation("ClaimVerifier")
  statementImports  StatementImport[]

  @@map("users")
}

model DashboardWidgetPreference {
  id        String   @id @default(cuid())
  userId    String
  tab       String
  widgetId  String
  visible   Boolean  @default(true)
  column    Int      @default(0)
  position  Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tab, widgetId])
  @@index([userId, tab, column, position])
}

// Auth.js required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  code      String
  purpose   String    // "LOGIN" | "REGISTER" | "RESET"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

// ─────────────────────────────────────────────
// COURSES
// ─────────────────────────────────────────────

model Course {
  id                 String       @id @default(cuid())
  title              String
  slug               String       @unique
  description        String       @db.Text
  shortDescription   String?
  thumbnailUrl       String?
  flyerS3Key         String?      // admin-uploaded course flyer (image or PDF)
  status             CourseStatus @default(DRAFT)
  // Category: "PROFESSIONAL" requires title+reg number; "OPEN" is open to all
  category           String       @default("OPEN")  // "OPEN" | "PROFESSIONAL"
  targetAudience     String?      @db.Text  // e.g. "Nurses, midwives, clinical officers"
  eligibilityText    String?      @db.Text  // shown on apply form
  durationMonths     Int?         // preferred over durationWeeks for real courses
  freePreviewPercent Int          @default(12)
  minimumAttendancePercent Int    @default(75)
  fullFeeUgx         Int?         // null means "contact admissions"
  feeContactOnly     Boolean      @default(false) // true = hide fee, show contact message
  instalmentCount    Int          @default(1)
  durationWeeks      Int?         // kept for backward compat
  accreditationText  String?
  intakeLabel        String?      // e.g. "November 2026"
  contentNote        String?      @db.Text // e.g. "draft for Principal review"
  tutorId            String
  accessThresholds   Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tutor        User         @relation("CourseMainTutor", fields: [tutorId], references: [id])
  coTutors     CoTutor[]
  blocks       Block[]
  intakes      Intake[]
  enrolments   Enrolment[]
  exams        Exam[]
  liveClasses  LiveClass[]
  certificates Certificate[]
  assignments  Assignment[]
  announcements Announcement[]
  forumThreads ForumThread[]
  gradeEntries GradeEntry[]
  applications Application[]

  @@map("courses")
}

model CoTutor {
  id       String @id @default(cuid())
  courseId String
  tutorId  String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor  User   @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([courseId, tutorId])
  @@map("co_tutors")
}

model Block {
  id                    String   @id @default(cuid())
  courseId              String
  order                 Int
  title                 String
  description           String?  @db.Text
  prerequisiteBlockOrder Int?    // must complete exam in this block order first (null = no gate)
  createdAt             DateTime @default(now())

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  instalments Instalment[]
  liveClasses LiveClass[]
  exams       Exam[]
  assignments Assignment[]

  @@unique([courseId, order])
  @@map("blocks")
}

model Lesson {
  id            String     @id @default(cuid())
  blockId       String
  order         Int
  title         String
  type          LessonType
  bunnyVideoId  String?    // Bunny Stream video GUID
  notesS3Key    String?    // S3 object key
  isFree        Boolean    @default(false)  // always free, even logged-out
  isFreePreview Boolean    @default(false)  // free for registered-not-enrolled users
  durationSec   Int?
  transcript    String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  block          Block            @relation(fields: [blockId], references: [id], onDelete: Cascade)
  progress       LessonProgress[]
  quizQuestions  QuizQuestion[]

  @@unique([blockId, order])
  @@map("lessons")
}

model QuizQuestion {
  id            String       @id @default(cuid())
  lessonId      String?
  examId        String?
  text          String       @db.Text
  type          QuestionType
  options       Json?        // [{id, text}] for MCQ
  correctAnswer String?      // option id or "true"/"false"
  points        Int          @default(1)
  explanation   String?      @db.Text
  createdAt     DateTime     @default(now())

  lesson          Lesson?            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exam            Exam?              @relation(fields: [examId], references: [id], onDelete: Cascade)
  shortAnswerReviews ShortAnswerReview[]

  @@map("quiz_questions")
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  completedAt  DateTime?
  watchPercent Int       @default(0)
  updatedAt    DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ─────────────────────────────────────────────
// INTAKES
// ─────────────────────────────────────────────

model Intake {
  id               String   @id @default(cuid())
  courseId         String
  label            String   // e.g. "November 2026 Cohort"
  startDate        DateTime
  endDate          DateTime
  seats            Int
  isOpen           Boolean  @default(true)
  createdAt        DateTime @default(now())

  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolments    Enrolment[]
  applications  Application[]

  @@map("intakes")
}

// ─────────────────────────────────────────────
// APPLICATIONS (Batch A3)
// Public applicants fill a form; creates an Application record only.
// No account is created until the Registrar processes it.
// ─────────────────────────────────────────────

enum ApplicationStatus {
  SUBMITTED       // applicant submitted; waiting for Registrar
  UNDER_REVIEW    // Registrar opened
  ACCEPTED        // account created, invite sent
  REJECTED        // not admitted
  WITHDRAWN       // applicant withdrew
}

model Application {
  id                   String            @id @default(cuid())
  // Course and intake
  courseId             String?
  intakeId             String?
  // Applicant details
  fullName             String
  email                String
  phone                String
  category             String            @default("OPEN") // "OPEN" | "PROFESSIONAL"
  professionalTitle    String?
  registrationNumber   String?
  highestQualification String?
  dateOfBirth          DateTime?
  gender               String?
  district             String?
  howHeard             String?
  notes                String?           @db.Text
  // Status
  status               ApplicationStatus @default(SUBMITTED)
  reviewedById         String?
  reviewedAt           DateTime?
  rejectionReason      String?           @db.Text
  // If accepted: link to the created user account
  createdUserId        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  course      Course?  @relation(fields: [courseId], references: [id])
  intake      Intake?  @relation(fields: [intakeId], references: [id])

  @@map("applications")
}

// Add relation back on Course for applications


// ─────────────────────────────────────────────
// ENROLMENT & PAYMENTS
// ─────────────────────────────────────────────

model Enrolment {
  id              String          @id @default(cuid())
  userId          String
  courseId        String
  intakeId        String?
  status          EnrolmentStatus @default(PENDING_PAYMENT)
  planType        String          @default("FULL") // "FULL" | "INSTALMENT"
  totalAmountUgx  Int
  paidAmountUgx   Int             @default(0)
  unlockedBlockOrder Int          @default(0) // highest block order unlocked
  paidPercent     Int             @default(0) // 0-100
  // Overdue / grace period
  overdueSince    DateTime?       // when the missed instalment became overdue
  graceUntil      DateTime?       // overdue access window ends here
  // Provisional bank-transfer access
  provisionalUntil DateTime?      // temporary access granted pending bank approval
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  course       Course        @relation(fields: [courseId], references: [id])
  intake       Intake?       @relation(fields: [intakeId], references: [id])
  payments     Payment[]
  instalments  Instalment[]
  ledger       LedgerEntry[]
  claims       ManualPaymentClaim[]

  @@unique([userId, courseId])
  @@map("enrolments")
}

model Payment {
  id               String         @id @default(cuid())
  enrolmentId      String
  amount           Int            // UGX
  currency         String         @default("UGX")
  method           PaymentMethod
  gateway          PaymentGateway
  gatewayRef       String?        @unique
  gatewayOrderId   String?
  status           PaymentStatus  @default(PENDING)
  paidAt           DateTime?
  receiptS3Key     String?        // generated receipt PDF
  // Bank transfer fields
  bankReceiptS3Key String?        // student-uploaded bank receipt image/PDF
  bankTransferRef  String?        // student-provided bank reference number
  bankName         String?        // bank name e.g. "Stanbic", "Centenary"
  bankApprovedBy   String?        // admin user ID who approved
  bankApprovedAt   DateTime?
  bankRejectedAt   DateTime?
  bankRejectedReason String?
  //
  failureReason    String?
  refundedAt       DateTime?
  refundedBy       String?
  notes            String?        // admin internal notes
  // Manual claim fields
  claimId          String?        @unique
  receiptNumber    String?        @unique
  reversedAt       DateTime?
  reversedBy       String?
  reversalReason   String?
  fraudStrike      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  enrolment  Enrolment    @relation(fields: [enrolmentId], references: [id])
  instalment Instalment?
  claim      ManualPaymentClaim? @relation(fields: [claimId], references: [id])

  @@map("payments")
}

model Instalment {
  id             String    @id @default(cuid())
  enrolmentId    String
  number         Int
  amount         Int
  dueDate        DateTime?
  paidAt         DateTime?
  unlocksBlockId String?
  paymentId      String?   @unique
  createdAt      DateTime  @default(now())

  enrolment     Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  unlocksBlock  Block?    @relation(fields: [unlocksBlockId], references: [id])
  payment       Payment?  @relation(fields: [paymentId], references: [id])

  @@unique([enrolmentId, number])
  @@map("instalments")
}

model LedgerEntry {
  id                String          @id @default(cuid())
  enrolmentId       String
  type              LedgerEntryType
  amount            Int
  balanceAfter      Int
  description       String
  paymentId         String?
  receiptNumber     String?
  reversedAt        DateTime?
  reversedByEntryId String?
  createdAt         DateTime        @default(now())

  enrolment Enrolment @relation(fields: [enrolmentId], references: [id])

  @@map("ledger_entries")
}

// ─────────────────────────────────────────────
// LIVE CLASSES
// ─────────────────────────────────────────────

model LiveClass {
  id            String          @id @default(cuid())
  courseId      String
  blockId       String?
  tutorId       String
  title         String
  description   String?
  scheduledAt   DateTime
  durationMin   Int             @default(60)
  joinUrl       String
  recordingUrl  String?
  platform      String          @default("link") // link|bbb|jitsi
  providerMeetingId String?
  recordingEnabled Boolean      @default(true)
  recordingStatus String        @default("PENDING")
  studentsMaySpeak Boolean      @default(false)
  selfCheckInOpensAt DateTime?
  selfCheckInClosesAt DateTime?
  minimumAttendancePercent Int  @default(75)
  status        LiveClassStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  course     Course       @relation(fields: [courseId], references: [id])
  block      Block?       @relation(fields: [blockId], references: [id])
  tutor      User         @relation(fields: [tutorId], references: [id])
  attendance Attendance[]
  reminders  LiveClassReminder[]

  @@map("live_classes")
}

model Attendance {
  id           String    @id @default(cuid())
  liveClassId  String
  userId       String
  joinedAt     DateTime?
  admissionRequestedAt DateTime?
  admittedAt   DateTime?
  leftAt       DateTime?
  startMark    AttendanceMark?
  endMark      AttendanceMark?
  startComment String?   @db.Text
  endComment   String?   @db.Text
  selfCheckedInAt DateTime?
  handRaisedAt DateTime?
  canSpeak     Boolean   @default(false)
  isMuted      Boolean   @default(true)
  isPresenter  Boolean   @default(false)
  markedPresent Boolean  @default(false)
  createdAt    DateTime  @default(now())

  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, userId])
  @@map("attendance")
}

model PlatformPresence {
  userId       String   @id
  lastSeenAt   DateTime @default(now())
  currentClassId String?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
  @@map("platform_presence")
}

model LiveClassReminder {
  id           String    @id @default(cuid())
  liveClassId  String
  channel      String
  remindAt     DateTime
  processingAt DateTime?
  sentAt       DateTime?
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  liveClass    LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, channel, remindAt])
  @@index([remindAt, sentAt])
  @@map("live_class_reminders")
}

// ─────────────────────────────────────────────
// EXAMS
// ─────────────────────────────────────────────

model Exam {
  id             String     @id @default(cuid())
  courseId       String
  blockId        String?
  title          String
  instructions   String?    @db.Text
  timeLimitMin   Int?
  attemptLimit   Int        @default(2)
  passPercent    Int        @default(60)
  shuffleQuestions Boolean  @default(true)
  status         ExamStatus @default(DRAFT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  course    Course         @relation(fields: [courseId], references: [id])
  block     Block?         @relation(fields: [blockId], references: [id])
  questions QuizQuestion[]
  attempts  ExamAttempt[]

  @@map("exams")
}

model ExamAttempt {
  id           String        @id @default(cuid())
  examId       String
  userId       String
  number       Int
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  timeLimitEndsAt DateTime?
  score        Int?
  maxScore     Int?
  passed       Boolean?
  tabSwitches  Int           @default(0)
  answers      Json          // {questionId: answer}
  createdAt    DateTime      @default(now())

  exam              Exam               @relation(fields: [examId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  shortAnswerReviews ShortAnswerReview[]

  @@unique([examId, userId, number])
  @@map("exam_attempts")
}

model ShortAnswerReview {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  tutorId    String
  score      Int
  feedback   String?  @db.Text
  reviewedAt DateTime @default(now())

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])
  tutor    User         @relation(fields: [tutorId], references: [id])

  @@unique([attemptId, questionId])
  @@map("short_answer_reviews")
}

// ─────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────

model Certificate {
  id            String    @id @default(cuid())
  userId        String
  courseId      String
  uniqueId      String    @unique // e.g. MTC-2026-CNA-00042
  issuedAt      DateTime  @default(now())
  fileS3Key     String?
  revokedAt     DateTime?
  revokedReason String?
  revokedBy     String?

  user          User          @relation(fields: [userId], references: [id])
  course        Course        @relation(fields: [courseId], references: [id])
  verifications CertVerification[]

  @@map("certificates")
}

model CertVerification {
  id            String   @id @default(cuid())
  certificateId String
  checkedAt     DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  certificate Certificate @relation(fields: [certificateId], references: [id])

  @@map("cert_verifications")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  type      String              // e.g. PAYMENT_RECEIPT, CLASS_REMINDER
  subject   String?
  body      String              @db.Text
  metadata  Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPref {
  id      String              @id @default(cuid())
  userId  String
  channel NotificationChannel
  type    String
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, type])
  @@map("notification_prefs")
}

// ─────────────────────────────────────────────
// RESOURCES
// ─────────────────────────────────────────────

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  s3Key       String
  mimeType    String   @default("application/pdf")
  category    String?
  isPublic    Boolean  @default(true)
  uploadedBy  String
  createdAt   DateTime @default(now())

  uploader User @relation(fields: [uploadedBy], references: [id])

  @@map("resources")
}

// ─────────────────────────────────────────────
// PARTNER PAGES
// ─────────────────────────────────────────────

model PartnerPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  partnerName String
  logoS3Key   String?
  heading     String
  body        String   @db.Text
  ctaText     String   @default("Enrol Now")
  ctaUrl      String   @default("/auth/register")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partner_pages")
}

// ─────────────────────────────────────────────
// SITE SETTINGS
// ─────────────────────────────────────────────

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("site_settings")
}

// ─────────────────────────────────────────────
// GRADEBOOK (materialised summary per student per course)
// Updated by triggers / background jobs after each exam/assignment
// ─────────────────────────────────────────────

model GradeEntry {
  id           String    @id @default(cuid())
  userId       String
  courseId     String
  itemType     String    // "EXAM" | "ASSIGNMENT"
  itemId       String    // examId or assignmentId
  itemTitle    String
  score        Int?
  maxScore     Int?
  percentage   Float?
  passed       Boolean?
  gradedAt     DateTime?
  updatedAt    DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, itemType, itemId])
  @@map("grade_entries")
}

// ─────────────────────────────────────────────
// ASSIGNMENTS
// ─────────────────────────────────────────────

model Assignment {
  id            String           @id @default(cuid())
  courseId      String
  blockId       String?
  title         String
  instructions  String           @db.Text
  dueDate       DateTime?
  maxPoints     Int              @default(100)
  status        AssignmentStatus @default(DRAFT)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  course      Course             @relation(fields: [courseId], references: [id])
  block       Block?             @relation(fields: [blockId], references: [id])
  submissions AssignmentSubmission[]

  @@map("assignments")
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  fileS3Key    String?          // uploaded file
  textBody     String?          @db.Text
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  grade        Int?
  feedback     String?          @db.Text
  gradedBy     String?
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])
  grader     User?      @relation("GraderSubmissions", fields: [gradedBy], references: [id])

  @@unique([assignmentId, userId])
  @@map("assignment_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
  LATE
}

// ─────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  courseId  String?  // null = site-wide
  authorId  String
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course? @relation(fields: [courseId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@map("announcements")
}

// ─────────────────────────────────────────────
// DISCUSSION FORUM
// ─────────────────────────────────────────────

model ForumThread {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course      @relation(fields: [courseId], references: [id])
  author  User        @relation(fields: [authorId], references: [id])
  replies ForumReply[]

  @@map("forum_threads")
}

model ForumReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id])

  @@map("forum_replies")
}

// ─────────────────────────────────────────────
// SUPPORT TICKETS
// ─────────────────────────────────────────────

model SupportTicket {
  id          String        @id @default(cuid())
  userId      String
  subject     String
  body        String        @db.Text
  status      TicketStatus  @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User              @relation(fields: [userId], references: [id])
  assignee User?             @relation("AssignedTickets", fields: [assignedTo], references: [id])
  replies  SupportReply[]

  @@map("support_tickets")
}

model SupportReply {
  id       String   @id @default(cuid())
  ticketId String
  authorId String
  body     String   @db.Text
  isStaff  Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@map("support_replies")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String?
  entityId   String?
  metadata   Json?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User? @relation("ActorAuditLog", fields: [actorId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// APPROVAL REQUESTS
// Separation of duties: initiator ≠ approver.
// Only SUPERADMIN can approve.
// ─────────────────────────────────────────────

model ApprovalRequest {
  id           String                @id @default(cuid())
  type         ApprovalRequestType
  status       ApprovalRequestStatus @default(PENDING)
  initiatorId  String
  // Subject entity references (all optional; use whichever applies)
  studentId    String?
  enrolmentId  String?
  paymentId    String?
  staffUserId  String?               // for staff account actions
  // Request details
  amount       Int?                  // for REFUND / WAIVER / FEE_CHANGE (UGX)
  reason       String                @db.Text
  evidence     String?               // S3 key or URL to supporting doc
  // Decision
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?               @db.Text
  // Secure approval link
  approvalToken        String?       @unique
  approvalTokenExpires DateTime?
  // Timestamps
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  initiator  User  @relation("ApprovalInitiator", fields: [initiatorId], references: [id])
  decidedBy  User? @relation("ApprovalDecider",   fields: [decidedById], references: [id])

  @@map("approval_requests")
}

// ─────────────────────────────────────────────
// BREAK-GLASS ACCESS
// SYSTEM_IT requesting temporary data access;
// requires SUPERADMIN approval.
// ─────────────────────────────────────────────

model BreakGlassGrant {
  id          String    @id @default(cuid())
  requesterId String
  reason      String    @db.Text
  scope       String                // e.g. "student_payments", "personal_data"
  grantedById String?
  grantedAt   DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  accessedAt  DateTime?             // when requester first used the grant
  createdAt   DateTime  @default(now())

  requester User  @relation(fields: [requesterId], references: [id])

  @@map("break_glass_grants")
}

// ─────────────────────────────────────────────
// QUARTERLY ACCESS REVIEW
// ─────────────────────────────────────────────

model AccessReview {
  id           String   @id @default(cuid())
  reviewedById String
  quarter      String   // e.g. "2026-Q4"
  notes        String?  @db.Text
  completedAt  DateTime @default(now())

  @@map("access_reviews")
}

// ─────────────────────────────────────────────
// STAFF INVITES
// SUPERADMIN creates an invite; invitee clicks the link,
// sets their password, and (for SUPERADMIN) completes TOTP setup.
// ─────────────────────────────────────────────

model StaffInvite {
  id          String    @id @default(cuid())
  email       String
  role        UserRole
  token       String    @unique  // secure random hex, single-use
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  // For student invites: points to the pre-created user account
  userId      String?
  courseId    String?   // optional teaching assignment applied when the invite is accepted
  intakeId    String?   // selected student intake shown on the invite review screen

  createdBy User  @relation(fields: [createdById], references: [id])
  user      User? @relation("StudentInviteUser", fields: [userId], references: [id])

  @@map("staff_invites")
}

// ─────────────────────────────────────────────
// MANUAL PAYMENT CLAIMS
// ─────────────────────────────────────────────

model ManualPaymentClaim {
  id                 String              @id @default(cuid())
  enrolmentId        String
  claimantId         String
  method             ManualPaymentMethod
  transactionId      String              @unique
  amount             Int
  payerName          String
  payerPhone         String
  bankOrProvider     String
  claimedAt          DateTime
  status             ClaimStatus         @default(SUBMITTED)
  receiptS3Key       String?
  receiptSha256      String?
  receiptPHash       String?
  receiptExifFlags   Json?
  duplicateImageFlag Boolean             @default(false)
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?             @db.Text
  verifiedById       String?
  verifiedAt         DateTime?
  statementLineId    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  enrolment     Enrolment       @relation(fields: [enrolmentId], references: [id])
  claimant      User            @relation("ClaimantClaims", fields: [claimantId], references: [id])
  reviewer      User?           @relation("ClaimReviewer", fields: [reviewedById], references: [id])
  verifier      User?           @relation("ClaimVerifier", fields: [verifiedById], references: [id])
  statementLine StatementLine?  @relation(fields: [statementLineId], references: [id])
  payment       Payment?

  @@map("manual_payment_claims")
}

// ─────────────────────────────────────────────
// BANK STATEMENT IMPORTS
// ─────────────────────────────────────────────

model StatementImport {
  id             String          @id @default(cuid())
  uploadedById   String
  filename       String
  bank           String
  periodStart    DateTime
  periodEnd      DateTime
  lineCount      Int
  matchedCount   Int             @default(0)
  unmatchedCount Int             @default(0)
  unclaimedCount Int             @default(0)
  s3Key          String
  createdAt      DateTime        @default(now())

  uploadedBy User            @relation(fields: [uploadedById], references: [id])
  lines      StatementLine[]

  @@map("statement_imports")
}

model StatementLine {
  id          String   @id @default(cuid())
  importId    String
  lineNumber  Int
  txDate      DateTime
  reference   String
  description String?
  amount      Int
  matchStatus String   @default("UNMATCHED")
  createdAt   DateTime @default(now())

  import  StatementImport        @relation(fields: [importId], references: [id], onDelete: Cascade)
  claims  ManualPaymentClaim[]

  @@map("statement_lines")
}
