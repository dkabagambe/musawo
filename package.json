{
  "name": "mtc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"if(!process.env.SKIP_DB_MIGRATE){require('child_process').execSync('npx prisma migrate deploy',{stdio:'inherit'})}\" && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "demo:reset": "docker compose down -v && docker compose up -d postgres redis && until docker compose exec postgres pg_isready -U mtc -d mtc_db -q; do sleep 1; done && npx prisma migrate deploy && npx prisma db seed",
    "demo:start": "docker compose up -d postgres redis && until docker compose exec postgres pg_isready -U mtc -d mtc_db -q; do sleep 1; done && npx prisma migrate deploy && npx prisma db seed && npm run dev",
    "rate-limit:reset": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/rate-limit-reset.ts",
    "verify:roles": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/verify-roles.ts",
    "seed:remote": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed-remote.ts",
    "db:seed-topup": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-topup.ts",
    "bootstrap:prod": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/bootstrap-prod.ts",
    "reset-2fa": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/reset-2fa.ts",
    "seed:test": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed-test.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "5.22.0",
    "@react-pdf/renderer": "4.1.6",
    "@types/leaflet": "1.9.14",
    "@types/node": "20.17.9",
    "@types/qrcode": "1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "argon2": "0.41.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "framer-motion": "^11.18.2",
    "idb": "8.0.2",
    "ioredis": "5.4.2",
    "leaflet": "1.9.4",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "next-pwa": "5.6.0",
    "next-themes": "0.4.6",
    "otpauth": "9.5.2",
    "postcss": "^8",
    "prisma": "5.22.0",
    "qrcode": "1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-image-crop": "^11.1.2",
    "resend": "4.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@vitest/coverage-v8": "^2.1.9",
    "playwright": "1.49.1",
    "ts-node": "10.9.2",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
