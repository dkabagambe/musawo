{
  "name": "mtc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "demo:reset": "docker compose down -v && docker compose up -d postgres redis && until docker compose exec postgres pg_isready -U mtc -d mtc_db -q; do sleep 1; done && npx prisma migrate deploy && npx prisma db seed",
    "demo:start": "docker compose up -d postgres redis && until docker compose exec postgres pg_isready -U mtc -d mtc_db -q; do sleep 1; done && npx prisma migrate deploy && npx prisma db seed && npm run dev",
    "rate-limit:reset": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/rate-limit-reset.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.4",
    "@aws-sdk/client-s3": "3.679.0",
    "@aws-sdk/s3-request-presigner": "3.679.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "5.22.0",
    "@react-pdf/renderer": "4.1.6",
    "argon2": "0.41.1",
    "framer-motion": "^11.18.2",
    "idb": "8.0.2",
    "ioredis": "5.4.2",
    "leaflet": "1.9.4",
    "lucide-react": "0.460.0",
    "next": "14.2.29",
    "next-auth": "5.0.0-beta.25",
    "next-pwa": "5.6.0",
    "otpauth": "9.5.2",
    "prisma": "5.22.0",
    "qrcode": "1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "resend": "4.0.1",
    "sharp": "^0.35.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/leaflet": "1.9.14",
    "@types/node": "20.17.9",
    "@types/qrcode": "1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "playwright": "1.49.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "10.9.2",
    "typescript": "^5",
    "vitest": "2.1.8"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
