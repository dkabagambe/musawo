# Environment — Musawo Training Center
# Copy this file to .env and fill in all values before running.

# ─── App ──────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NODE_ENV=development

# APP_ENV controls demo features independently of NODE_ENV.
# development | staging → /dev/login, demo payments, email console logs, noindex headers
# production            → demo features blocked, real email/payments expected
APP_ENV=development

# Auth.js v5 — required when running behind a reverse proxy (Render, etc.)
# Set to your public URL: https://your-app.onrender.com or https://learn.musawotraining.ug
AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# AUTH_TRUST_HOST must be true in development and on any reverse-proxy deployment.
# next-auth v5 requires AUTH_URL or AUTH_TRUST_HOST=true; without one of these
# the middleware throws "UntrustedHost". Keep this true for local dev and staging.
AUTH_TRUST_HOST=true

# ─── Encryption keys ──────────────────────────
# DATA_ENCRYPTION_KEY: protects personal ID numbers, medical data in the DB.
# TOTP_ENCRYPTION_KEY: protects stored TOTP secrets in the DB.
# Generate both with: openssl rand -hex 32
# TOTP_ENCRYPTION_KEY must be exactly 64 hex characters (32 bytes).
DATA_ENCRYPTION_KEY=generate-a-dedicated-random-secret-for-encrypted-personal-data
TOTP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32-must-be-64-hex-chars

# ─── Demo / Dev flags ─────────────────────────
# DEMO_MODE=true  -> use simulated payment gateway (safe for presentations)
# TOTP_REQUIRED=true -> force TOTP setup for DIRECTOR/PRINCIPAL even in staging/dev
# These flags are only active when APP_ENV is development or staging.
DEMO_MODE=true
TOTP_REQUIRED=false

# ─── Demo gate (HTTP Basic Auth) ──────────────
# Set BOTH to enable a site-wide password gate (useful for staging demos).
# Leave blank to disable.
# DEMO_GATE_USER=demo
# DEMO_GATE_PASSWORD=change-this

# ─── Database ─────────────────────────────────
# Local development only. Use long random passwords in production.
POSTGRES_USER=mtc
POSTGRES_PASSWORD=mtc12345
POSTGRES_DB=mtc_db
DATABASE_URL="postgresql://mtc:mtc12345@localhost:5432/mtc_db?schema=public"
# Bound the Prisma connection pool per process (5 per worker on Render free tier).
# Increase to 10-15 if you upgrade to a dedicated DB with higher max_connections.
DB_CONNECTION_LIMIT=5

# ─── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Live classes ─────────────────────────────
LIVE_CLASS_PROVIDER=link
BBB_URL=
BBB_SECRET=
BBB_ATTENDEE_PASSWORD=
BBB_MODERATOR_PASSWORD=
JITSI_ENABLED=false
CRON_SECRET=generate-a-random-secret-for-scheduled-jobs

# ─── Payments ─────────────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
# For sandbox: https://cybqa.pesapal.com/pesapalv3

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ─── Bunny Stream ─────────────────────────────
BUNNY_STREAM_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_SIGNING_KEY=
BUNNY_CDN_HOSTNAME=iframe.mediadelivery.net

# ─── S3-compatible Storage ────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mtc-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Email (Resend) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM=MTC <noreply@musawotraining.ug>

# ─── SMS (Africa's Talking) ───────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=MUSAWO

# ─── WhatsApp Business Cloud (Phase 2) ────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_CLASS_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ─── Internal webhook secrets ─────────────────
PESAPAL_WEBHOOK_SECRET=change-me
FLUTTERWAVE_WEBHOOK_SECRET=change-me
