# Environment — Musawo Training Center
# Copy this file to .env and fill in all values before running.

# ─── App ──────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
DATA_ENCRYPTION_KEY=generate-a-dedicated-random-secret-for-encrypted-personal-data
NODE_ENV=development

# ─── Demo / Dev flags ─────────────────────────
# DEMO_MODE=true  → use simulated payment gateway (safe for presentations)
# TOTP_REQUIRED is controlled per-user in the DB (totpEnabled field).
# These flags are IGNORED when NODE_ENV=production.
DEMO_MODE=true

# ─── Database ─────────────────────────────────
# Local development only. Use long random passwords in production.
POSTGRES_USER=mtc
POSTGRES_PASSWORD=mtc12345
POSTGRES_DB=mtc_db
DATABASE_URL="postgresql://mtc:mtc12345@localhost:5432/mtc_db?schema=public"

# ─── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Live classes ─────────────────────────────
LIVE_CLASS_PROVIDER=link
BBB_URL=
BBB_SECRET=
BBB_ATTENDEE_PASSWORD=
BBB_MODERATOR_PASSWORD=
JITSI_ENABLED=false
CRON_SECRET=generate-a-random-secret-for-scheduled-jobs

# ─── Payments ─────────────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
# For sandbox: https://cybqa.pesapal.com/pesapalv3

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ─── Bunny Stream ─────────────────────────────
BUNNY_STREAM_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_SIGNING_KEY=
BUNNY_CDN_HOSTNAME=iframe.mediadelivery.net

# ─── S3-compatible Storage ────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mtc-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Email (Resend) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM=MTC <noreply@musawotraining.ug>

# ─── SMS (Africa's Talking) ───────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=MUSAWO

# ─── WhatsApp Business Cloud (Phase 2) ────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_CLASS_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ─── Internal webhook secrets ─────────────────
PESAPAL_WEBHOOK_SECRET=change-me
FLUTTERWAVE_WEBHOOK_SECRET=change-me
